<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/follo_grey">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Power button (13 Nov 2026): while the app is Off no map is shown, only what to tap. Clickable, so nothing
         behind it gets a touch. MainActivity keeps the words inside the part of the screen the map would show in. -->
    <FrameLayout
        android:id="@+id/offCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/follo_grey"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <TextView
            android:id="@+id/offText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:drawablePadding="20dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/follo_off_map"
            android:textColor="@color/follo_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:drawableTopCompat="@drawable/ic_follo_power" />
    </FrameLayout>

    <!-- 13 Nov 2026 (Alex: "give more space to the map"): one title line with the power button at its right; the second
         line and the button only for the states that have them. The version is on the bottom line. -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/follo_grey"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/follo_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <org.owntracks.android.ui.main.FolloPowerButton
                android:id="@+id/power"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/follo_white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="40dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/follo_white"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- The notice (when shown) and the card, at the foot of the screen. Padding rather than margins, so their shadows
         are not cut off; MainActivity adds the navigation bar to the bottom padding. Not clickable: a touch beside the
         card goes to the map. The elevation is for the phone held sideways: the banner is then a column down the left
         (6dp) and this sits at its foot, so it must be above it (0.1.38 had none and the card was hidden there). -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="8dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- "No search area loaded yet…": just above the card until the wake-up circles arrive (13 Nov 2026; it was
             the banner's last line) -->
        <TextView
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_follo_notice"
            android:elevation="6dp"
            android:lineSpacingMultiplier="1.1"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/follo_ready_none"
            android:textColor="@color/follo_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_follo_card"
            android:clickable="true"
            android:contentDescription="@string/follo_recentre"
            android:elevation="8dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="13dp"
            android:paddingEnd="16dp"
            android:paddingBottom="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/who"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/follo_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Shown while the map is held away from the arrow (13 Nov 2026). Not clickable: the whole card is
                     the button, these words only say what a tap on it does. -->
                <TextView
                    android:id="@+id/recentre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:text="@string/follo_recentre_hint"
                    android:textColor="@color/follo_green"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_follo_recentre" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/last"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/follo_subtext"
                    android:textSize="15sp" />

                <!-- Offline map (13 Nov 2026; a line of words until then): green = saved, red = not saved yet. A tap
                     on it shows the words, or asks about mobile data while it waits for Wi-Fi (MainActivity) -->
                <ImageView
                    android:id="@+id/offlineIcon"
                    android:layout_width="24dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_follo_map"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/follo_note"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- The bottom line, under the card (13 Nov 2026): the imagery's credit (its licence wants it visible), the day of
         the wake-up circles, the version; each on its own pill. MainActivity keeps it above the navigation bar. -->
    <LinearLayout
        android:id="@+id/creditBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="5dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_follo_credit"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/circlesDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_follo_credit"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/build"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_follo_credit"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- The rotate button (wording page tile R, 14 Nov 2026): over the map at the top right, 12 dp under the banner
         (sideways, under the status bar, clear of the navigation bar). Each tap turns the screen a quarter turn
         clockwise: 90, 180, 270, then upright again (FolloScreenTurner). MainActivity sets its top and end margins. -->
    <ImageButton
        android:id="@+id/rotate"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_follo_round"
        android:contentDescription="@string/follo_rotate"
        android:elevation="4dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_follo_rotate" />
</FrameLayout>
