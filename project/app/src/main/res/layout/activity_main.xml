<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/follo_grey">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Power button (13 Nov 2026): while the app is Off no map is shown, only what to tap. Clickable, so nothing
         behind it gets a touch. MainActivity keeps the words inside the part of the screen the map would show in. -->
    <FrameLayout
        android:id="@+id/offCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/follo_grey"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <TextView
            android:id="@+id/offText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:drawablePadding="20dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/follo_off_map"
            android:textColor="@color/follo_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:drawableTopCompat="@drawable/ic_follo_power" />
    </FrameLayout>

    <!-- Sideways the Samsung's status bar runs across the top: a strip in the banner's colour behind it, so the status
         panel at the top right hangs straight under it (14 Nov 2026). Upright the banner itself goes under the status bar. -->
    <View
        android:id="@+id/statusStrip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/follo_grey"
        android:elevation="6dp"
        android:visibility="gone" />

    <!-- The banner (13 Nov 2026: one title line; the second line and the button only for the states that have them).
         Upright it runs across the top; sideways (14 Nov 2026) it is the status panel hard into the top right corner,
         280 dp wide, as tall as its words (MainActivity). The power button moved to the card (14 Nov 2026). -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:background="@color/follo_grey"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/follo_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/follo_white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="40dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/follo_white"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- The bottom band (Alex 14 Nov 2026): one dark area across the whole width, from just above its row down to the
         foot of the screen (behind the navigation bar). Left: the imagery's credit (its licence wants it visible).
         Right: the three ticks — checked in today (green ring = the circles), offline map saved, latest app; a warning
         sign for any that isn't right; one tap shares the phone check. MainActivity adds the navigation bar below. -->
    <LinearLayout
        android:id="@+id/creditBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B8101211"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/credit"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/ticks"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_follo_ticks"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tickCircles"
                style="@style/FolloTick" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_follo_ring" />

            <TextView
                android:id="@+id/tickMap"
                style="@style/FolloTick"
                android:layout_marginStart="7dp" />

            <TextView
                style="@style/FolloTickLabel"
                android:text="@string/follo_tick_map" />

            <TextView
                android:id="@+id/tickApp"
                style="@style/FolloTick"
                android:layout_marginStart="7dp" />

            <TextView
                style="@style/FolloTickLabel"
                android:text="@string/follo_tick_app" />
        </LinearLayout>
    </LinearLayout>

    <!-- The notice (when shown) and the card, just above the bottom band. Padding rather than margins, so their shadows
         are not cut off; MainActivity sets the bottom padding to the band's height. Not clickable: a touch beside the
         card goes to the map or the band. Sideways (14 Nov 2026) it is as wide as the status panel, hard into the right
         side, sitting on the band. -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:elevation="8dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- "No search area loaded yet…": just above the card until the wake-up circles arrive (13 Nov 2026; it was
             the banner's last line) -->
        <TextView
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_follo_notice"
            android:elevation="6dp"
            android:lineSpacingMultiplier="1.1"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/follo_ready_none"
            android:textColor="@color/follo_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- The card: who this phone is and when it last sent, the power button at its right (14 Nov 2026; it was at
             the banner's top right). Press and hold the card = check in now; a touch that starts on the power button is
             the button's alone. -->
        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_follo_card"
            android:baselineAligned="false"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="13dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/who"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/follo_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/follo_subtext"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/follo_note"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <org.owntracks.android.ui.main.FolloPowerButton
                android:id="@+id/power"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- The phone's own position (Alex 13-14 Nov 2026): just above the right end of the card, whenever the app has a
         position. Press and hold = share it (with "GDA2020" and the MGA grid reference). MainActivity places it. -->
    <TextView
        android:id="@+id/coords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_follo_coords"
        android:elevation="4dp"
        android:fontFeatureSettings="tnum"
        android:longClickable="true"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/follo_white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- The recentre button (wording page, 13 Nov 2026: four arrows pointing in): top left, level with the rotate button,
         only while the map is held where it was moved by hand. A tap follows again at walking scale. -->
    <ImageButton
        android:id="@+id/recentre"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_follo_round"
        android:contentDescription="@string/follo_recentre"
        android:elevation="4dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_follo_recentre"
        android:visibility="gone" />

    <!-- The rotate button (wording page tile R, 14 Nov 2026): over the map at the top right, 12 dp under the banner
         (sideways, under the status bar, clear of the navigation bar). Each tap turns the screen a quarter turn
         clockwise: 90, 180, 270, then upright again (FolloScreenTurner). MainActivity sets its top and end margins. -->
    <ImageButton
        android:id="@+id/rotate"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_follo_round"
        android:contentDescription="@string/follo_rotate"
        android:elevation="4dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_follo_rotate" />
</FrameLayout>
