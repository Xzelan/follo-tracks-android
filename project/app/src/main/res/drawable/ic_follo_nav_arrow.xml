        android:strokeWidth="7.2"
        android:strokeLineJoin="round"
        android:pathData="M24,4L8.5,44L24,34.91L39.5,44Z" />
    <path
        android:fillColor="#1A73E8"
        android:strokeColor="#1A73E8"
