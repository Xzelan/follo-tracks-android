<?xml version="1.0" encoding="utf-8"?>
<!-- FOLLO Tracks talks only to FOLLO's server and the imagery host, both https; nothing in the clear, no user CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
