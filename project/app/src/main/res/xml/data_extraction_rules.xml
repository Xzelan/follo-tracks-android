<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <include
            domain="sharedpref"
            path="." />
        <!-- FOLLO: the walking track and the server password stay on the phone -->
        <exclude
            domain="sharedpref"
            path="follo_track.xml" />
        <!-- and the last server status, which names teammates' location topics (review B4, 28 Oct 2026) -->
        <exclude
            domain="sharedpref"
            path="follo_status.xml" />
        <exclude
            domain="sharedpref"
            path="au.org.follo.tracks_preferences.xml" />
        <!-- FOLLO: never restored onto a phone (24 Nov 2026: a reinstall came back in "Share everywhere" without the OK;
             ring and watch state belong to where THIS phone was) -->
        <exclude
            domain="sharedpref"
            path="follo_everywhere.xml" />
        <exclude
            domain="sharedpref"
            path="follo_rings.xml" />
        <exclude
            domain="sharedpref"
            path="follo_watch.xml" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" />
        <include domain="file" />
        <!-- FOLLO: the map's tile cache (with the offline map, ~220 MB) is fetched again by the new phone -->
        <exclude
            domain="file"
            path="osmdroid/" />
        <include
            domain="database"
            path="." />
        <include
            domain="sharedpref"
            path="." />
        <!-- FOLLO: never restored onto a phone (24 Nov 2026: a reinstall came back in "Share everywhere" without the OK;
             ring and watch state belong to where THIS phone was) -->
        <exclude
            domain="sharedpref"
            path="follo_everywhere.xml" />
        <exclude
            domain="sharedpref"
            path="follo_rings.xml" />
        <exclude
            domain="sharedpref"
            path="follo_watch.xml" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
