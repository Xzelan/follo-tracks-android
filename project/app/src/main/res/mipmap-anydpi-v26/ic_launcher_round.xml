<!-- FOLLO Tracks launcher (icon concept 142, 25 Oct 2026): FOLLO wordmark, magenta tracklog and nav arrow over 20 m contours.
     Background = the contours on map green (bitmap, cut wider than the icon so the visible area is filled); foreground = wordmark,
     track and arrow inside the 66 dp safe zone; monochrome = the same without colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
